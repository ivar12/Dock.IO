# ---------------------------------------------------------------------------
# Secrets (copy this file to .env and replace the placeholders)
# ---------------------------------------------------------------------------
# e.g. python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET
SESSION_HTTPS_ONLY=true

# Base64-encoded bcrypt hash for the local admin password.
# Generate with:
#   python3 -c "import bcrypt,base64; print(base64.b64encode(bcrypt.hashpw(b'your-password', bcrypt.gensalt())).decode())"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH_B64=REPLACE_WITH_BASE64_BCRYPT_HASH

# ---------------------------------------------------------------------------
# OpenID Connect (set OIDC_ENABLED=true after creating the authentik app)
# ---------------------------------------------------------------------------
OIDC_ENABLED=false
OIDC_CLIENT_ID=dockermgr
OIDC_CLIENT_SECRET=REPLACE_WITH_AUTHENTIK_CLIENT_SECRET
OIDC_BASE_URL=https://authentik.home.networktechlab.nl
OIDC_SLUG=dockermgr
# OIDC_AUTHORIZE_URL=
# OIDC_TOKEN_URL=
# OIDC_USERINFO_URL=
OIDC_REDIRECT_URL=https://dockermgr.home.networktechlab.nl/auth/callback
OIDC_SCOPES=openid profile email
OIDC_USER_CLAIM=preferred_username

# ---------------------------------------------------------------------------
# App behaviour
# ---------------------------------------------------------------------------
TZ=Europe/Amsterdam
SELF_CONTAINER=dockermgr
