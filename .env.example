# ---------------------------------------------------------------------------
# Secrets (copy this file to .env and replace the placeholders)
# ---------------------------------------------------------------------------
# e.g. python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET
SESSION_HTTPS_ONLY=true

# No admin account is configured here. On first launch, open the app in a
# browser and create the first administrator from the /setup page. Passwords
# are bcrypt-hashed and stored in the app database.

# ---------------------------------------------------------------------------
# OpenID Connect (optional; set OIDC_ENABLED=true when your provider is ready)
# The default endpoint paths below are authentik-style.
# ---------------------------------------------------------------------------
OIDC_ENABLED=false
OIDC_CLIENT_ID=REPLACE_WITH_OIDC_CLIENT_ID
OIDC_CLIENT_SECRET=REPLACE_WITH_OIDC_CLIENT_SECRET
OIDC_BASE_URL=https://auth.example.com
OIDC_SLUG=dockio
# OIDC_AUTHORIZE_URL=
# OIDC_TOKEN_URL=
# OIDC_USERINFO_URL=
OIDC_REDIRECT_URL=https://dockio.example.com/auth/callback
OIDC_SCOPES=openid profile email
OIDC_USER_CLAIM=preferred_username

# ---------------------------------------------------------------------------
# App behaviour
# ---------------------------------------------------------------------------
TZ=UTC
SELF_CONTAINER=dockio

# Container updates are only marked complete after the recreated container is
# running and healthy. Increase the timeout for slow-starting containers.
UPDATE_VERIFY_TIMEOUT=15
UPDATE_VERIFY_INTERVAL=2
UPDATE_VERIFY_STABLE_CHECKS=2
# Retry transient container-name conflicts during recreate.
UPDATE_CREATE_ATTEMPTS=3
# How long completed/failed updates stay visible on the Updates page.
UPDATE_HISTORY_MINUTES=5
